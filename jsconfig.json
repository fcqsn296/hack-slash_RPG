{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "moduleDetection": "force",
    "module": "None"
  },
  "include": ["src/**/*.js", "data/**/*.js", "test/**/*.js"]
}
